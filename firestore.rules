rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Survey responses: public can create (submit surveys) and read aggregated/status
    // Updates and deletions are strictly disabled (immutable record log)
    match /responses/{responseId} {
      allow create, read: if true;
      allow update, delete: if false;
    }

    // Broadcast logs: public can read confirmed announcements
    // Only created via authenticated backend / admin; updates & deletes blocked
    match /broadcasts/{broadcastId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Public host applications: public can submit applications (create only)
    // Client-side reads, updates, and deletes are strictly prohibited
    match /host_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Member Profiles & Persisted RSVPs:
    // Members can read profiles and can only write/update their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
