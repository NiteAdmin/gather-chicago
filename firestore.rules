rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Responses: Direct client writes disabled; all persistence handled via server Admin SDK.
    match /responses/{responseId} {
      allow create: if false;
      allow read, update: if request.auth != null &&
                             request.auth.token.email_verified == true &&
                             resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    // Users: Strict ownership verification
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Broadcasts: Read-only for clients; creation via server Admin SDK only
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if false;
    }

    // Community Polls: Read-only for public; updates restricted
    match /communityPolls/{pollDocId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
